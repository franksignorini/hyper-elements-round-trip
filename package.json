{
  "name": "hyper-elements-round-trip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/embed-sources.mjs && tsx scripts/bake-clients.tsx && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/embed-sources.mjs && next typegen && tsc --noEmit",
    "art": "tsx scripts/art.tsx",
    "check": "hyper-elements check template/Newsletter.tsx template/issue.values.json examples/welcome/Welcome.tsx examples/welcome/welcome.values.json",
    "push": "tsx scripts/roundtrip.tsx push",
    "pull": "tsx scripts/roundtrip.tsx pull",
    "selftest": "tsx scripts/selftest.tsx",
    "bake:clients": "tsx scripts/bake-clients.tsx"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hyper-elements/email-clients": "^0.5.3",
    "@hyper-elements/react": "^0.5.2",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "diff": "^9.0.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@hyper-elements/cli": "^0.3.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "satori": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "hyperElements": {
    "templates": ["template/**", "examples/**"]
  },
  "overrides": {
    "@hyper-elements/email-clients": "$@hyper-elements/email-clients"
  },
  "type": "module"
}
